<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "production" (pas "development") : le pipeline CI (ios-build.yml)
	     signe exclusivement en distribution App Store Connect (certificat
	     "Apple Distribution" + profil de distribution) — aucun build de
	     développement local n'existe pour cette app. Un binaire signé pour
	     l'App Store/TestFlight doit obligatoirement utiliser l'environnement
	     APNs "production", sinon les push envoyés par Firebase (qui route
	     via l'APNs production) ne sont jamais délivrés à l'appareil. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- "Se connecter avec Apple" (sign_in_with_apple). La capability doit
	     aussi être activée sur l'App ID com.kartapp.app dans le portail
	     Apple Developer, et le profil de distribution régénéré. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Lecture de la carte NFC KART (activation en la tapant sur le
	     téléphone, cf. DeviceNfcTagReader). "TAG" seulement : c'est le
	     format lu par NFCTagReaderSession. La capability « NFC Tag
	     Reading » doit aussi être activée sur l'App ID com.kartapp.app dans
	     le portail Apple Developer, AVANT le build : le pipeline CI génère
	     le profil de distribution à partir des capabilities de l'App ID.
	     Va de pair avec NFCReaderUsageDescription (Info.plist) et
	     kIosNfcReadingEnabled (nfc_tag_reader.dart). -->
	<!-- Lien universel : le bouton « Confirmer mon adresse » de l'email
	     (https://kart.business/verifier-email/…) ouvre l'app. La capability
	     « Associated Domains » est activée sur l'App ID par le pipeline CI
	     (ios-build.yml) ; kart.business doit servir
	     /.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:kart.business</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
